<div id="formView"><h3 id="mt">🏬 Visit Smart Mobile Hub</h3><small>Book a free demo. We will keep your phone ready.</small>
<div id="fm">
<label>Your Name<input id="nm" autocomplete="name"></label><div class="err" id="e1"></div>
<label>Mobile Number<input id="mb" inputmode="numeric" maxlength="10" autocomplete="tel"></label><div class="err" id="e2"></div>
<label>Interested Phone<select id="ph"><option>Nova X5 5G</option><option>Pixel Lite Pro</option><option>Gamer Z Ultra</option><option>Easy Smart 4G</option><option>Not decided</option></select></label>
<label>Visit Date<input id="dt" type="date"></label><div class="err" id="e3"></div>
<button class="btn" id="go" style="width:100%;margin-top:12px;padding:11px">Confirm My Visit</button></div></div>
<div id="okView" style="display:none;text-align:center"><div style="font-size:3rem">✅</div><h3>Visit Booked!</h3><p id="sum"></p>
<div class="links"><a id="wa" target="_blank" rel="noopener">WhatsApp Us</a><a id="map" target="_blank" rel="noopener">Open Map</a><button id="cp">Copy Details</button></div></div>
</div></div>
<div id="toast"></div>

<script>
// ===== Edit these store details =====
var STORE={name:"Smart Mobile Hub",wa:"919999999999",addr:"[Your Store Address], Nagpur"};
var $=function(i){return document.getElementById(i)};
var ov=$("ov"),lastFocus=null,info="";
function toast(m){var t=$("toast");t.textContent=m;t.classList.add("show");clearTimeout(t.h);t.h=setTimeout(function(){t.classList.remove("show")},2600)}
function openM(phone){lastFocus=document.activeElement;$("formView").style.display="";$("okView").style.display="none";
 if(phone)$("ph").value=phone;var d=new Date().toISOString().split("T")[0];$("dt").min=d;if(!$("dt").value)$("dt").value=d;
 ov.classList.add("show");setTimeout(function(){$("nm").focus()},50)}
function closeM(){ov.classList.remove("show");if(lastFocus)lastFocus.focus()}
// button click events
document.querySelectorAll("[data-open]").forEach(function(b){b.addEventListener("click",function(){openM()})});
document.querySelectorAll("[data-phone]").forEach(function(b){b.addEventListener("click",function(){openM(b.dataset.phone);toast("Selected "+b.dataset.phone)})});
$("close").addEventListener("click",closeM);
ov.addEventListener("click",function(e){if(e.target===ov)closeM()});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&ov.classList.contains("show"))closeM();if(e.key==="Enter"&&ov.classList.contains("show")&&$("formView").style.display!=="none"&&e.target.tagName!=="BUTTON")$("go").click()});
// live validation (input events)
$("mb").addEventListener("input",function(){this.value=this.value.replace(/\D/g,"");$("e2").textContent=""});
$("nm").addEventListener("input",function(){$("e1").textContent=""});
// submit event
$("go").addEventListener("click",function(){
 var n=$("nm").value.trim(),m=$("mb").value,ok=true;
 $("e1").textContent=n.length<2?(ok=false,"Please enter your name"):"";
 $("e2").textContent=!/^[6-9]\d{9}$/.test(m)?(ok=false,"Enter a valid 10-digit mobile number"):"";
 $("e3").textContent=!$("dt").value?(ok=false,"Select a visit date"):"";
 if(!ok){toast("Please fix the highlighted fields");return}
 var p=$("ph").value,d=$("dt").value;
 info="Hello "+STORE.name+", I am "+n+" ("+m+"). I will visit your store on "+d+" to see "+p+".";
 $("sum").innerHTML="Thank you <b>"+n.replace(/[<>&]/g,"")+"</b>! We will keep <b>"+p+"</b> ready for you on <b>"+d+"</b>.<br>📍 "+STORE.addr;
 $("wa").href="https://wa.me/"+STORE.wa+"?text="+encodeURIComponent(info);
 $("map").href="https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(STORE.name+" "+STORE.addr);
 $("formView").style.display="none";$("okView").style.display="block";toast("Visit booked successfully!");
 try{localStorage.setItem("lastVisit",d)}catch(x){}
});
$("cp").addEventListener("click",function(){
 if(navigator.clipboard)navigator.clipboard.writeText(info).then(function(){toast("Details copied")},function(){toast("Copy not allowed")});else toast("Copy not supported")});
// tabs
$("tabs").addEventListener("click",function(e){var t=e.target.closest(".tab");if(!t)return;
 document.querySelectorAll(".tab").forEach(function(x){x.classList.toggle("on",x===t)});
 document.querySelectorAll(".panel").forEach(function(x){x.classList.toggle("on",x.id===t.dataset.t)})});
// theme toggle
$("theme").addEventListener("click",function(){var r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme:dark)").matches;r.dataset.theme=dark?"light":"dark"});
// counters on scroll
var io=new IntersectionObserver(function(es){es.forEach(function(en){if(!en.isIntersecting)return;io.unobserve(en.target);
 var el=en.target,end=+el.dataset.n,s=null;(function f(t){s=s||t;var p=Math.min((t-s)/1200,1);el.textContent=Math.floor(end*p)+(p===1?"+":"");if(p<1)requestAnimationFrame(f)})(performance.now())})},{threshold:.5});
document.querySelectorAll("[data-n]").forEach(function(e){io.observe(e)});
</script>
